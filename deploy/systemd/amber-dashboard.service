[Unit]
Description=Amber dashboard (Streamlit, bound to localhost — reach it over an SSH tunnel)
After=network-online.target

[Service]
Type=simple
User=amber
WorkingDirectory=/opt/amber
ExecStart=/opt/amber/.venv/bin/python -m streamlit run amber/dashboard/app.py \
  --server.address=127.0.0.1 --server.port=8501 --server.headless=true
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
